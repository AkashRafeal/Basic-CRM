# ===================================================
# Basic CRM - Environment Configuration Template
# ===================================================

# --- PostgreSQL Database ---
DATABASE_URL="postgresql://user:password@host:port/database"
SPRING_DATASOURCE_URL="jdbc:postgresql://host:port/database?sslmode=require"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=require

# --- Discovery Service (Netflix Eureka) ---
EUREKA_SERVER_PORT=8761
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# --- API Gateway ---
GATEWAY_PORT=8080

# --- Microservices Ports ---
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
LEAD_SERVICE_PORT=8083
CUSTOMER_SERVICE_PORT=8084
TASK_SERVICE_PORT=8085
FOLLOWUP_SERVICE_PORT=8086
PIPELINE_SERVICE_PORT=8087
ANALYTICS_SERVICE_PORT=8088
CONTACT_SERVICE_PORT=8089
CALL_SERVICE_PORT=8090
COMMUNICATION_SERVICE_PORT=8091
PRODUCT_SERVICE_PORT=8092
ACTIVITY_SERVICE_PORT=8093
APPOINTMENT_SERVICE_PORT=8094

# --- Security & JWT Secret Configuration ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# --- Frontend Web Application ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
